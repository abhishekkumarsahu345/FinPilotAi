DJANGO_SECRET_KEY=replace-this-for-any-shared-deployment
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DB_NAME=finpilot
DB_USER=finpilot
DB_PASSWORD=finpilot-local-only
DB_HOST=127.0.0.1
DB_PORT=5432
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Celery / Redis
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# File storage (MinIO / S3-compatible)
AWS_ACCESS_KEY_ID=finpilot-local
AWS_SECRET_ACCESS_KEY=finpilot-local-secret
AWS_STORAGE_BUCKET_NAME=finpilot-files
AWS_S3_ENDPOINT_URL=http://127.0.0.1:9000
FILE_STORAGE_PRESIGN_EXPIRY_SECONDS=900

# Email (configure your transactional provider here)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_FROM=noreply@finpilot.ai
# For SMTP: EMAIL_HOST, EMAIL_PORT, EMAIL_HOST_USER, EMAIL_HOST_PASSWORD, EMAIL_USE_TLS

# AI provider (add your chosen LLM API key here)
AI_PROVIDER=openai
OPENAI_API_KEY=

# Webhook signing secrets (set by your email/messaging provider)
EMAIL_WEBHOOK_SECRET=
MESSAGING_WEBHOOK_SECRET=
