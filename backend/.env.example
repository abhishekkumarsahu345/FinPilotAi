DJANGO_SECRET_KEY=replace-this-for-any-shared-deployment
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DB_NAME=finpilot
DB_USER=finpilot
DB_PASSWORD=finpilot-local-only
DB_HOST=127.0.0.1
DB_PORT=5432
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Celery / Redis
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# File storage (MinIO / S3-compatible)
AWS_ACCESS_KEY_ID=finpilot-local
AWS_SECRET_ACCESS_KEY=finpilot-local-secret
AWS_STORAGE_BUCKET_NAME=finpilot-files
AWS_S3_ENDPOINT_URL=http://127.0.0.1:9000
FILE_STORAGE_PRESIGN_EXPIRY_SECONDS=900

# Email Configuration
# For development/testing: console backend prints emails to terminal
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_FROM=noreply@finpilot.ai

# For production with Gmail (requires app password):
# 1. Enable 2-factor authentication on your Google account
# 2. Generate app password: https://myaccount.google.com/apppasswords
# 3. Use these settings:
#EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#EMAIL_HOST=smtp.gmail.com
#EMAIL_PORT=587
#EMAIL_HOST_USER=your-email@gmail.com
#EMAIL_HOST_PASSWORD=your-16-char-app-password
#EMAIL_USE_TLS=true
#EMAIL_FROM=your-email@gmail.com

# For production with transactional email providers (SendGrid, Mailgun, Amazon SES):
# SendGrid example:
#EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#EMAIL_HOST=smtp.sendgrid.net
#EMAIL_PORT=587
#EMAIL_HOST_USER=apikey
#EMAIL_HOST_PASSWORD=your-sendgrid-api-key
#EMAIL_USE_TLS=true
#EMAIL_FROM=noreply@yourdomain.com

# AI provider (add your chosen LLM API key here)
AI_PROVIDER=openai
OPENAI_API_KEY=

# Google OAuth (for "Continue with Google" authentication)
# Get these from: https://console.cloud.google.com/ ? APIs & Services ? Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback/
# Clock skew tolerance in seconds for ID token verification (default: 10, max: 30)
# Helps handle minor time differences between your server and Google's servers
GOOGLE_OAUTH_CLOCK_SKEW_SECONDS=10

# Webhook signing secrets (set by your email/messaging provider)
EMAIL_WEBHOOK_SECRET=
MESSAGING_WEBHOOK_SECRET=
